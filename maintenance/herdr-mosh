#!/usr/bin/env python3
"""Run herdr for a mosh client without herdr's opaque background fill (docs/herdr.md).

Herdr 0.9.3 keeps a "host background" color in the server and, after a client
attaches again, paints it over older panes as an opaque fill
(herdrdev/herdr#3773). mosh never answers the OSC 10/11 color queries, so the
fill shows as a solid block instead of the terminal's own, often transparent,
background.

    herdr-mosh [herdr arguments...]    (default: --session default)

Runs herdr in its own pseudo-terminal. Keys and window size go through
unchanged. In herdr's output, a truecolor background (48;2;R;G;B, 48:2:R:G:B,
48:2::R:G:B or 48:2:<cs>:R:G:B) whose RGB is on the fill list becomes the
default background (49). Every other byte passes through unchanged. Exits
with herdr's exit status.

HERDR_MOSH_FILL: comma-separated hex colors, default "1e1e1e,232136" (herdr's
own fallback and a rose-pine-moon background). An empty value changes nothing.

Remove it when herdr fixes #3773.
"""

import fcntl
import os
import pty
import re
import select
import signal
import sys
import termios
import tty

HERDR = os.environ.get("HERDR_BIN_PATH", "herdr")
SGR = re.compile(rb"\x1b\[([0-9;:]*)m")
# What a read can end in that may still become an SGR sequence.
PARTIAL = re.compile(rb"\x1b(?:\[[0-9;:]*)?")
HOLD = 0.05  # seconds a partial sequence waits for its rest before it goes out as is


def fill_colors(spec: str) -> set[tuple[int, ...]]:
    return {tuple(bytes.fromhex(c.strip().removeprefix("#"))) for c in spec.split(",") if c.strip()}


def rgb(parts: list[bytes]) -> tuple[int, ...] | None:
    try:
        return tuple(int(p) for p in parts)
    except ValueError:  # an empty component
        return None


def params(text: bytes, fill: set) -> bytes:
    """SGR parameters with every fill background replaced by 49, the rest as is.

    Walks whole parameter groups, so the B of `38;2;R;G;48` or the N of
    `38;5;48` is never read as the start of a background.
    """
    p = text.split(b";")
    out, i = [], 0
    while i < len(p):
        sub = p[i].split(b":")
        if len(sub) > 1:  # colon form: the whole group is one parameter
            bg = sub[:2] == [b"48", b"2"] and len(sub) in (5, 6) and rgb(sub[-3:]) in fill
            out.append(b"49" if bg else p[i])
            i += 1
        elif p[i] in (b"38", b"48", b"58") and p[i + 1 : i + 2] in ([b"2"], [b"5"]):
            n = 5 if p[i + 1] == b"2" else 3
            group = p[i : i + n]
            bg = p[i] == b"48" and n == 5 and len(group) == 5 and rgb(group[2:]) in fill
            out += [b"49"] if bg else group
            i += n
        else:
            out.append(p[i])
            i += 1
    return b";".join(out)


def rewrite(data: bytes, fill: set) -> bytes:
    if not fill or b"48" not in data:
        return data
    return SGR.sub(lambda m: b"\x1b[" + params(m[1], fill) + b"m", data)


def feed(held: bytes, data: bytes, fill: set) -> tuple[bytes, bytes]:
    """(bytes to write, bytes to hold): a sequence cut by the read waits for its rest."""
    data = held + data
    cut = data.rfind(b"\x1b")
    if cut >= 0 and PARTIAL.fullmatch(data, cut):
        return rewrite(data[:cut], fill), data[cut:]
    return rewrite(data, fill), b""


def write_all(fd: int, data: bytes) -> None:
    while data:
        data = data[os.write(fd, data) :]


def winsize(fd: int) -> bytes:
    return fcntl.ioctl(fd, termios.TIOCGWINSZ, bytes(8))


def main() -> int:
    fill = fill_colors(os.environ.get("HERDR_MOSH_FILL", "1e1e1e,232136"))
    args = sys.argv[1:] or ["--session", "default"]
    size = winsize(0)
    pid, master = pty.fork()
    if pid == 0:
        # Before exec, so herdr's first look at the grid sees the real size.
        fcntl.ioctl(0, termios.TIOCSWINSZ, size)
        os.execvp(HERDR, [HERDR, *args])
    signal.signal(signal.SIGWINCH, lambda *_: fcntl.ioctl(master, termios.TIOCSWINSZ, winsize(0)))
    saved = termios.tcgetattr(0)
    held = b""
    try:
        tty.setraw(0)
        while True:
            ready, _, _ = select.select([0, master], [], [], HOLD if held else None)
            if not ready:
                write_all(1, held)
                held = b""
            if master in ready:
                try:
                    data = os.read(master, 65536)
                except OSError:  # EIO: herdr exited and closed the terminal
                    data = b""
                if not data:
                    break
                out, held = feed(held, data, fill)
                write_all(1, out)
            if 0 in ready:
                data = os.read(0, 65536)
                if not data:
                    break
                write_all(master, data)
        write_all(1, held)
    finally:
        termios.tcsetattr(0, termios.TCSAFLUSH, saved)
    os.close(master)
    code = os.waitstatus_to_exitcode(os.waitpid(pid, 0)[1])
    return code if code >= 0 else 128 - code


if __name__ == "__main__":
    sys.exit(main())
