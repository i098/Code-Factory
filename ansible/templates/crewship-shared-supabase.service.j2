{{ ansible_managed | comment }}
# The ONE shared local Supabase stack (project {{ crewship_shared_supabase_project }}).
# check.sh is idempotent: `supabase start` on the existing volumes, then the
# DDL guard, then the env template every worktree receives. Started at login;
# crewship-shared-supabase-check.timer re-runs it every 5 minutes.
# Docs: {{ crewship_shared_supabase_dir }}/README.md

[Unit]
Description=Fleet shared Supabase stack - start at login, apply DDL guard (Crewship managed)
ConditionPathExists={{ crewship_shared_supabase_dir }}/check.sh
ConditionPathExists={{ crewship_shared_supabase_cli }}

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart={{ crewship_shared_supabase_dir }}/check.sh
ExecStop={{ crewship_shared_supabase_cli }} stop --workdir {{ crewship_shared_supabase_dir }}
TimeoutStartSec=900

[Install]
WantedBy=default.target
