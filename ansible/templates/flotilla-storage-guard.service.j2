{{ ansible_managed | comment }}
# Triggered by flotilla-storage-guard.timer; not enabled on its own.
# Measures the filesystems holding /, /var/log, the home and Docker's data root:
# alerts at WARN once per episode and early when the fill rate projects full,
# prunes only regenerable Docker data (build cache, dangling and old unused
# images) at CRIT.

[Unit]
Description=Fleet storage guard - alert on disk use, prune regenerable Docker data at CRIT (Code Factory managed)
ConditionPathExists={{ factory_fleet_doctor_dir }}/storage-guard.sh

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=STORAGE_WARN_PCT={{ factory_storage_guard_warn_pct }}
Environment=STORAGE_CRIT_PCT={{ factory_storage_guard_crit_pct }}
Environment=STORAGE_HYSTERESIS_PCT={{ factory_storage_guard_hysteresis_pct }}
Environment=STORAGE_IMAGE_AGE_HOURS={{ factory_storage_guard_image_age_hours }}
Environment=STORAGE_FILL_HORIZON_HOURS={{ factory_storage_guard_fill_horizon_hours }}
Environment=STORAGE_REPEAT_MIN={{ factory_storage_guard_repeat_min }}
ExecStart={{ factory_fleet_doctor_dir }}/storage-guard.sh
# du walk (<= 300 s) plus three bounded prune steps (<= 300 s each).
TimeoutStartSec=1500
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
