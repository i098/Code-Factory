{{ ansible_managed | comment }}
# Triggered by crewship-shared-supabase-check.timer; not enabled on its own.

[Unit]
Description=Fleet shared Supabase keeper tick - restart missing containers, re-apply guard (Crewship managed)
ConditionPathExists={{ crewship_shared_supabase_dir }}/check.sh

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart={{ crewship_shared_supabase_dir }}/check.sh
TimeoutStartSec=900
Nice=5
