{{ ansible_managed | comment }}
# One PathChanged per worktree pool: a new slot directory in the pool fires the
# seeder before the lane's first `bun run dev`. Pools: crewship.fleet.worktree_pools.

[Unit]
Description=Fleet worktree env seed - trigger on swarms-platform pool changes (Crewship managed)

[Path]
{% for pool in crewship_cfg.fleet.worktree_pools %}
PathChanged={{ crewship_cfg.home }}/{{ pool }}
{% endfor %}
Unit=crewship-worktree-env-seed.service

[Install]
WantedBy=default.target
